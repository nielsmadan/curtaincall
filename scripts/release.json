{
  "name": "Curtaincall",
  "repository": "nielsmadan/curtaincall",
  "workflow": "release.yml",
  "branch": "main",
  "initial_version": "1.0.0",
  "tag_prefix": "v",
  "tools": ["git", "uv", "uvx", "just"],
  "checks": [["just", "check-static"], ["just", "coverage"]],
  "stages": [
    {
      "files": ["pyproject.toml", "uv.lock", "CHANGELOG.md"],
      "commands": [
        ["{python}", "scripts/prepare_release.py", "{version}"],
        ["uv", "lock"],
        ["just", "changelog", "{version}"]
      ],
      "checks": [["just", "build"], ["just", "check-package"]],
      "message": "chore: release {version}"
    }
  ],
  "publication": "GitHub Actions verifies the tagged source and publishes a GitHub release with wheel and source distribution assets."
}
